{
  "name": "nextera-equipment-intelligence-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic NextEra equipment-health demo backed by CockroachDB.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "tsx src/commands/bootstrap.ts",
    "db:migrate": "tsx src/commands/migrate.ts",
    "db:seed": "tsx src/commands/seed.ts",
    "db:reset": "tsx src/commands/reset.ts",
    "db:health": "tsx src/commands/health.ts",
    "db:incident": "tsx src/commands/incident.ts",
    "db:explain": "tsx src/commands/explain.ts",
    "db:explain-embedding": "tsx src/commands/explain-embedding.ts",
    "db:document-source": "tsx src/commands/document-source.ts",
    "db:embed": "tsx src/commands/embed.ts",
    "db:retrieval-golden": "tsx src/commands/retrieval-golden.ts",
    "db:vector-provenance": "tsx src/commands/vector-provenance-status.ts",
    "test:generation-contract": "tsx src/commands/generation-contract.ts",
    "test:a12-generation-contract": "tsx src/commands/a12-generation-contract.ts",
    "smoke:adversarial-generation": "tsx src/commands/adversarial-generation-smoke.ts",
    "smoke:fallback-analysis": "tsx src/commands/fallback-analysis-smoke.ts",
    "smoke:a12-fallback-analysis": "tsx src/commands/a12-fallback-analysis-smoke.ts",
    "smoke:a12-live-generation": "tsx src/commands/a12-live-generation-smoke.ts",
    "smoke:a12-http": "tsx src/commands/a12-http-smoke.ts",
    "smoke:p09-fallback-analysis": "tsx src/commands/p09-fallback-analysis-smoke.ts",
    "smoke:p09-http": "tsx src/commands/p09-http-smoke.ts",
    "smoke:p09-live-generation": "tsx src/commands/p09-live-generation-smoke.ts",
    "smoke:inspection-generation": "tsx src/commands/inspection-generation-smoke.ts",
    "smoke:question-safety": "tsx src/commands/question-safety-smoke.ts",
    "smoke:live-generation": "tsx src/commands/live-vector-smoke.ts",
    "smoke:fleet-correlation": "tsx src/commands/fleet-correlation-http-smoke.ts",
    "smoke:vector-analysis": "tsx src/commands/live-vector-smoke.ts",
    "db:owner-setup": "npm run db:bootstrap && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "next": "16.3.2",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
